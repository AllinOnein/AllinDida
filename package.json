{
	"name": "allindida",
	"version": "2.1.1",
	"description": "将 Obsidian 待办双向同步到滴答清单（TickTick），支持中文界面。基于 thesamim/TickTickSync 修改。",
	"main": "main.js",
	"scripts": {
		"check": "tsc --noEmit",
		"lint": "eslint src/",
		"dev": " vite build --mode development --watch",
		"build": "vite build --mode production",
		"test": "vitest",
		"check:i18n": "node scripts/check-i18n.mjs",
		"sync-changelog": "node sync-notable-changes.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"obsidian-tasks",
		"task-manager",
		"task-management",
		"TickTick"
	],
	"author": "AllinOnein (fork of thesamim/TickTickSync)",
	"license": "GPL-3.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/AllinOnein/AllinDida.git"
	},
	"bugs": {
		"url": "https://github.com/AllinOnein/AllinDida/issues"
	},
	"dependencies": {
		"@types/lowdb": "^1.0.15",
		"bson-objectid": "^2.0.4",
		"crypto-hash": "^3.1.0",
		"dependency-tree": "^11.0.1",
		"dexie": "^4.2.1",
		"eventemitter2": "^6.4.9",
		"loglevel": "^1.9.2",
		"obsidian": "latest",
		"punycode": "^2.3.1",
		"rrule": "^2.8.1",
		"yaml": "^2.7.1"
	},
	"devDependencies": {
		"@rollup/plugin-replace": "^6.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@testing-library/jest-dom": "^6.4.2",
		"@tsconfig/svelte": "^5.0.4",
		"@types/lowdb": "^1.0.15",
		"@types/node": "^22.9.0",
		"@types/ua-parser-js": "^0.7.39",
		"@typescript-eslint/eslint-plugin": "^8.14.0",
		"@typescript-eslint/parser": "^8.14.0",
		"esbuild": ">=0.25.0",
		"esbuild-svelte": "^0.9.3",
		"eslint": "^10.6.0",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"fake-indexeddb": "^6.2.5",
		"jsdom": "^24.0.0",
		"svelte": "^5.33.9",
		"svelte-check": "^4.2.1",
		"svelte-preprocess": "^6.0.3",
		"tslib": "^2.8.1",
		"typescript": "^5.7.2",
		"ua-parser-js": "^1.0.39",
		"vite": "^8.0.16",
		"vite-tsconfig-paths": "^5.1.3",
		"vitest": ">=3.1.3"
	},
	"overrides": {
		"moment": "2.31.0"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"svelte-preprocess@6.0.5": true
	}
}
